# Used by the target agent, counterparty simulator and graders.
OPENROUTER_API_KEY=

# Optional dashboard default for target, simulator, and grader (CLI defaults unchanged).
REFUND_EVAL_DEFAULT_MODEL=openrouter/anthropic/claude-haiku-4.5

# Optional: enables real web search with the legacy tool profile.
TAVILY_API_KEY=

# Published live-Gmail mode only. Hybrid (simulated Gmail + live Exa web) needs
# no connector credentials/config and always uses keyless, rate-limited Exa.
REFUND_EVAL_PUBLISHED_CONFIG=.secrets/published-tools.json
GMAIL_MCP_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
# Optional Exa authentication for live-Gmail/legacy modes; ignored by hybrid.
EXA_API_KEY=
