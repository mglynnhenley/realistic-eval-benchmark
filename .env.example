# Used by the target agent, counterparty simulator, grader and Scout judges.
OPENROUTER_API_KEY=

# Optional dashboard target default. Simulator: Claude Opus 5.5; grader (simulator claim checks): Claude Haiku 4.5.
# Behaviours are graded after the run with Scout (see scout/README.md). This override does not change CLI defaults.
REFUND_EVAL_DEFAULT_MODEL=openrouter/anthropic/claude-haiku-4.5

# Hybrid web search uses keyless, rate-limited Exa MCP unless this opt-in key is set;
# fixture data uses simulated search.
REFUND_EVAL_EXA_API_KEY=
